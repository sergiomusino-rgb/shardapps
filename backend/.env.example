PORT=5005
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,https://shardapps.com,https://www.shardapps.com,https://zeusx.app,https://www.zeusx.app,https://zeusxapps.com
APP_URL=https://shardapps.com
FRONTEND_URL=https://shardapps.com

# AI Providers
# GROQ_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY: usati solo da /api/vision/analyze
# (analisi immagini, multi-provider, non ancora instradato dall'AI Router).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# OPENROUTER_API_KEY: richiesta da /api/chat e /api/generate-app tramite
# l'AI Router centralizzato (lib/ai-router.js). Instrada automaticamente su un
# modello "advanced" (generazione complessa, es. Claude Sonnet 5) o "fast"
# (chat, micro-fix) in base al task.
OPENROUTER_API_KEY=
# Override opzionali dei modelli usati dall'AI Router (default: vedi sopra)
# OPENROUTER_MODEL_ADVANCED=anthropic/claude-sonnet-5
# OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
# Soglia (USD) oltre la quale una singola chiamata AI viene loggata come warning
# AI_ROUTER_COST_WARN_USD=0.5

# Optional
HF_API_KEY=
FAL_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID opzionali per la fee ricorrente per piano (default hardcoded, vedi
# backend/server.js::getFeePriceId e routes/stripe.js)
# STRIPE_FEE_PRICE_STARTER=
# STRIPE_FEE_PRICE_PRO=
# STRIPE_FEE_PRICE_BUSINESS=
EXTRA_SLOT_PRICE_ID=

# Token condiviso per chiamate server-to-server dal frontend Next.js verso
# questo backend (vedi requireAuth in server.js e getUser in routes/stripe.js)
BACKEND_SERVICE_TOKEN=

# Admin
ADMIN_TOKEN=

# Totalum API
TOTALUM_API_KEY=
TOTALUM_API_URL=https://api-accounts.totalum.app
# MOCK_TOTALUM=true per bypassare le chiamate reali a Totalum in sviluppo
MOCK_TOTALUM=
