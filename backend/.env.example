PORT=5005
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,https://shardapps.com,https://www.shardapps.com,https://zeusx.app,https://www.zeusx.app,https://zeusxapps.com
APP_URL=https://shardapps.com
FRONTEND_URL=https://shardapps.com

# AI Providers
# GROQ_API_KEY: richiesta da POST /client/apps/:appId/chat (routes/client-app.js,
# assistente del GestionaleChatAssistant) — unico uso di Groq nel backend
# (Round 2 hardening: rimosso /api/vision/analyze, endpoint orfano senza
# alcun chiamante reale nel frontend, che usava anche GEMINI_API_KEY/
# OPENAI_API_KEY fuori dall'AI Router centralizzato — vedi lib/ai-router.js).
GROQ_API_KEY=
# Override opzionale del modello usato da POST /client/apps/:appId/chat
# (default invariato: llama-3.1-8b-instant). Per il pilot di migrazione a
# GPT-OSS via Groq: GROQ_CHAT_MODEL=openai/gpt-oss-20b (reasoning_effort/
# reasoning_format vengono applicati automaticamente dal codice solo quando
# il modello è un openai/gpt-oss-*). Rollback: rimuovere la variabile o
# riportarla a llama-3.1-8b-instant.
# GROQ_CHAT_MODEL=openai/gpt-oss-20b

# OPENROUTER_API_KEY: richiesta da /api/chat e /api/generate-app tramite
# l'AI Router centralizzato (lib/ai-router.js). Instrada automaticamente su un
# modello "advanced" (generazione complessa, es. Claude Sonnet 5) o "fast"
# (chat, micro-fix) in base al task.
OPENROUTER_API_KEY=
# Override opzionali dei modelli usati dall'AI Router (default: vedi sopra)
# OPENROUTER_MODEL_ADVANCED=anthropic/claude-sonnet-5
# OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
# Soglia (USD) oltre la quale una singola chiamata AI viene loggata come warning
# AI_ROUTER_COST_WARN_USD=0.5

# ─── Pre-Beta Hardening: AI Cost Control + reliability ─────────────────────
# Budget di default per un tenant SENZA override in tenants.ai_daily_budget_usd/
# ai_monthly_budget_usd (vedi supabase/migrations/20260826000000_ai_usage_budget.sql
# e lib/ai-usage.js). Superato il tetto, la chiamata AI viene bloccata PRIMA
# di raggiungere OpenRouter (AiBudgetExceededError), mai un semplice warning.
# AI_DEFAULT_DAILY_BUDGET_USD=5
# AI_DEFAULT_MONTHLY_BUDGET_USD=50
# Timeout esplicito per ogni chiamata OpenRouter (ms) — nessuna fetch resta
# appesa oltre questo limite.
# AI_ROUTER_TIMEOUT_MS=30000
# Attesa (ms) prima dell'unico retry ammesso su un errore transitorio (429/5xx/timeout).
# AI_ROUTER_RETRY_BACKOFF_MS=500
# Circuit breaker: dopo N fallimenti CONSECUTIVI del provider (post-retry),
# il circuito si apre per AI_CIRCUIT_BREAKER_COOLDOWN_MS millisecondi — nessuna
# nuova chiamata raggiunge OpenRouter finché non scade il raffreddamento.
# AI_CIRCUIT_BREAKER_THRESHOLD=5
# AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Optional
HF_API_KEY=
FAL_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID opzionali per la fee ricorrente per piano (default hardcoded, vedi
# backend/server.js::getFeePriceId e routes/stripe.js)
# STRIPE_FEE_PRICE_STARTER=
# STRIPE_FEE_PRICE_PRO=
# STRIPE_FEE_PRICE_BUSINESS=
EXTRA_SLOT_PRICE_ID=

# Token condiviso per chiamate server-to-server dal frontend Next.js verso
# questo backend (vedi requireAuth in server.js e getUser in routes/stripe.js)
BACKEND_SERVICE_TOKEN=

# Admin
ADMIN_TOKEN=

# Totalum API
TOTALUM_API_KEY=
TOTALUM_API_URL=https://api-accounts.totalum.app
# MOCK_TOTALUM=true per bypassare le chiamate reali a Totalum in sviluppo
MOCK_TOTALUM=
